	(text "ELRS RECEIVER (SpeedyBee ELRS, CRSF @ 420k baud on UART2)\nReceiver TX -> GPIO16 (ESP RX2), Receiver RX <- GPIO17 (ESP TX2)"
		(exclude_from_sim no)
		(at 240 70 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
