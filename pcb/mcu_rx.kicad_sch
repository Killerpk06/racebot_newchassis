		(uuid "20851607-33f9-5584-b9b9-ee1f1af663db")
	)
	(text "ESP32 38-pin DevKit (ESP-WROOM-32, DevKitC V4 pin order) on 2x 1x19 female headers.\nPin 1 of each row = antenna end. VERIFY against the board silkscreen before ordering.\nBoard is powered through its 5V pin from the LM2596. 3V3 pin = board LDO output (clamps only)."
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
