	)
	(text "POWER INPUT / PROTECTION\nXT60 (battery 3S, 9.0-12.6 V) -> 30 A ATO fuse -> VBAT_F -> J102 power switch / kill link -> VMOT.\nQ101: low-side N-MOSFET reverse-polarity protection in the ground return (D=battery -, S=GND).\nGate fed from VMOT (after the switch) so nothing drains the battery when switched off."
		(exclude_from_sim no)
		(at 20 20 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "507cede8-cb1d-5a09-bce5-82059053f353")
	)
	(text "5 V BUCK (LM2596S-5.0)  -> ESP32 5V pin, ELRS receiver, 74HCT244\nKeep VIN cap - U101 - D103 - C103 loop tight (see LAYOUT_NOTES.md)."
		(exclude_from_sim no)
		(at 20 100 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9cdcddc5-416f-57e6-aa5a-f3eef8b3868e")
	)
